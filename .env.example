# Backend Environment Variables

NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/safestack

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Gemini AI (Optional - leave as is for placeholder explanations)
GEMINI_API_KEY=your-gemini-api-key

# GitHub App (Optional - for GitHub integration)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage
UPLOAD_DIR=./storage/uploads
WORKING_DIR=./storage/working
MAX_UPLOAD_SIZE=52428800

# Docker (for isolated testing)
DOCKER_TEST_IMAGE=safestack-test-runner:latest
DOCKER_TEST_TIMEOUT=600000
DOCKER_TEST_MEMORY_LIMIT=512m
DOCKER_TEST_CPU_LIMIT=1.0
